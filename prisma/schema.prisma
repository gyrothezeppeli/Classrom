// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  nombre    String
  email     String   @unique
  password  String
  rol       String
  nivel     String?
  grado     String?
  seccion   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  estudiante Estudiante?
  docente    Docente?

  @@index([email])
  @@index([rol])
}

model Estudiante {
  id                    String   @id @default(cuid())
  nombres               String
  apellidos             String
  cedulaIdentidad       String   @unique
  fechaNacimiento       String
  edad                  String
  sexo                  String
  nivel                 String
  grado                 String
  seccion               String
  numeroTelefonoCelular String
  correoElectronico     String
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([cedulaIdentidad])
  @@index([nivel])
  @@index([grado])
  @@index([seccion])
}

model Docente {
  id                String   @id @default(cuid())
  nombres           String
  apellidos         String
  cedulaIdentidad   String   @unique
  email             String   @unique
  telefono          String
  especialidad      String
  nivel             String
  seccion           String
  fechaContratacion String
  activo            Boolean  @default(true)
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([cedulaIdentidad])
  @@index([email])
  @@index([nivel])
  @@index([seccion])
}

model Salon {
  id            String   @id @default(cuid())
  nombre        String
  nivel         String
  grado         String
  seccion       String
  docenteIds    String[]
  estudianteIds String[]
  anioAcademico String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([nivel])
  @@index([grado])
  @@index([seccion])
}
